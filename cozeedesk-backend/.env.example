# Environment Configuration Example
# Copy this file to .env and update the values

# Application Environment
NODE_ENV=development
PORT=3005

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
INTERMEDIATE_TOKEN_SECRET=your_intermediate_token_secret_here
INTERMEDIATE_TOKEN_EXPIRES_IN=2m

# Application URLs
BASE_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
SUPPORTED_FILE_TYPES=pdf,png,jpg,jpeg,gif

# Tenant Configuration
DEFAULT_SUBDOMAIN=app
PAID_TENANT_DOMAIN=cozeedesk.com
FREE_TENANT_DOMAIN=app.cozeedesk.com

# AI/OCR Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud Storage Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_KEY_FILE=./secrets/gcs-key.json
GCS_BUCKET_NAME=your_gcs_bucket_name

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=debug
ENABLE_DEBUG_LOGS=true

# Development Features
ENABLE_API_DOCS=true
ENABLE_CORS=true
ENABLE_DETAILED_ERRORS=true

# Security Configuration (Production)
TRUST_PROXY=false
ENABLE_RATE_LIMITING=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring Configuration (Production)
ENABLE_METRICS=false
SENTRY_DSN=your_sentry_dsn_if_using